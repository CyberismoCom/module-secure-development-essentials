{{#each cells}}{{#if (ne (add (max this.likelihood ../likelihood.length) (max this.impact ../impact.length)) (add ../likelihood.length ../impact.length))}}
WARNING: A cell at likelihood {{this.likelihood}}, impact {{this.impact}} falls outside this matrix, which has {{../likelihood.length}} likelihood levels and {{../impact.length}} impact levels. Its count of {{this.count}} is not shown.

{{/if}}{{/each}}{{#if levelGrid}}{{#if (ne levelGrid.length likelihood.length)}}
WARNING: The level grid has {{levelGrid.length}} rows, but this matrix has {{likelihood.length}} likelihood levels. Cells without a level are drawn in grey.

{{/if}}{{#each levelGrid}}{{#if (ne this.length @root.impact.length)}}
WARNING: Row {{add @index 1}} of the level grid has {{this.length}} entries, but this matrix has {{@root.impact.length}} impact levels. Cells without a level are drawn in grey.

{{/if}}{{#each this}}{{#if (ne (max this @root.levels.length) @root.levels.length)}}
WARNING: Row {{add @../index 1}} of the level grid refers to level {{this}}, but only {{@root.levels.length}} levels are defined. That cell is drawn in grey.

{{/if}}{{/each}}{{/each}}{{/if}}{{#vegaLite}}
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": {"step": 58},
    "height": {"step": 50},
    "background": "transparent",
    "view": {"stroke": null},
    "title": {
      "text": "{{{jsonEscape title}}}",
      "fontSize": 22,
      "fontWeight": "bold",
      "color": "currentColor",
      "anchor": "start"
    },
    "data": {
      "values": [
        {{#each likelihood as |lLabel lIdx|}}{{#each ../impact as |iLabel iIdx|}}
        {"l": {{lIdx}}, "i": {{iIdx}}, "lLabel": "{{{jsonEscape lLabel}}}", "iLabel": "{{{jsonEscape iLabel}}}", "key": "{{lIdx}}-{{iIdx}}"{{#with (lookup (lookup @root.levelGrid lIdx) iIdx)}}, "level": {{this}}{{/with}} }{{#unless @last}},{{/unless}}
        {{/each}}{{#unless @last}},{{/unless}}{{/each}}
      ]
    },
    "transform": [
      {{#if levels}}
      {
        "lookup": "level",
        "from": {
          "data": {
            "values": [
              {{#each levels}}
              {"level": {{add @index 1}}, "levelName": "{{{jsonEscape this.name}}}", "colour": {{this.colour}} }{{#unless @last}},{{/unless}}
              {{/each}}
            ]
          },
          "key": "level",
          "fields": ["levelName", "colour"]
        }
      },
      {
        "calculate": "datum.colour === 5 ? '#ffffff' : '#1a1a1a'",
        "as": "ink"
      }
      {{else}}
      {
        "joinaggregate": [
          {"op": "max", "field": "l", "as": "lMax"},
          {"op": "max", "field": "i", "as": "iMax"}
        ]
      },
      {
        "calculate": "(datum.l + datum.i) / (datum.lMax + datum.iMax) <= 1 / 3 ? '#0ca30c' : (datum.l + datum.i) / (datum.lMax + datum.iMax) <= 2 / 3 ? '#fab219' : '#d03b3b'",
        "as": "band"
      },
      {
        "calculate": "'#1a1a1a'",
        "as": "ink"
      }
      {{/if}}
    ],
    "layer": [
      {
        "mark": {
          "type": "rect",
          "width": {"band": 0.92},
          "height": {"band": 0.92},
          "cornerRadius": 2
        },
        "encoding": {
          "y": {
            "field": "lLabel",
            "type": "nominal",
            "sort": {"field": "l", "op": "max", "order": "descending"},
            "axis": {
              "title": "{{#if likelihoodTitle}}{{{jsonEscape likelihoodTitle}}}{{else}}Likelihood{{/if}}",
              "domain": false,
              "ticks": false,
              "grid": false,
              "labelFontSize": 12,
              "labelColor": "currentColor",
              "labelLimit": 0,
              "titleFontSize": 13,
              "titleFontWeight": "normal",
              "titleColor": "currentColor"
            }
          },
          "x": {
            "field": "iLabel",
            "type": "nominal",
            "sort": {"field": "i", "op": "max", "order": "ascending"},
            "axis": {
              "title": "{{#if impactTitle}}{{{jsonEscape impactTitle}}}{{else}}Impact{{/if}}",
              "orient": "bottom",
              "labelAngle": 0,
              "labelExpr": "split(replace(replace(datum.label, /(.{1,11})(\\s+|$)/g, '$1\\n'), /\\n$/, ''), '\\n')",
              "domain": false,
              "ticks": false,
              "grid": false,
              "labelFontSize": 12,
              "labelColor": "currentColor",
              "labelLimit": 0,
              "titleFontSize": 13,
              "titleFontWeight": "normal",
              "titleColor": "currentColor"
            }
          },
          {{#if levels}}
          "color": {
            "condition": {
              "test": "datum.levelName != null",
              "field": "levelName",
              "type": "nominal",
              "scale": {
                "domain": [{{#each levels}}{{#with (lookup @root.levels (subtract (subtract @root.levels.length 1) @index))}}"{{{jsonEscape this.name}}}"{{/with}}{{#unless @last}}, {{/unless}}{{/each}}],
                "range": [{{#each levels}}{{#with (lookup (lookup @root.levels (subtract (subtract @root.levels.length 1) @index)) "colour")}}"{{#if (eq this 1)}}#0ca30c{{/if}}{{#if (eq this 2)}}#b5e68a{{/if}}{{#if (eq this 3)}}#fab219{{/if}}{{#if (eq this 4)}}#d03b3b{{/if}}{{#if (eq this 5)}}#7a1414{{/if}}"{{/with}}{{#unless @last}}, {{/unless}}{{/each}}]
              },
              "legend": {
                "orient": "right",
                "title": null,
                "symbolType": "square",
                "symbolSize": 180,
                "symbolStrokeWidth": 0,
                "labelFontSize": 12,
                "labelColor": "currentColor",
                "labelLimit": 0
              }
            },
            "value": "#9a9a9a"
          }
          {{else}}
          "color": {"field": "band", "type": "nominal", "scale": null, "legend": null}
          {{/if}}
        }
      },
      {
        "transform": [
          {
            "lookup": "key",
            "from": {
              "data": {
                "values": [
                  {{#each cells}}
                  {"key": "{{subtract this.likelihood 1}}-{{subtract this.impact 1}}", "count": {{this.count}} }{{#unless @last}},{{/unless}}
                  {{/each}}
                ]
              },
              "key": "key",
              "fields": ["count"]
            }
          },
          {"filter": "datum.count > 0"}
        ],
        "mark": {
          "type": "text",
          "fontSize": 15,
          "fontWeight": "bold"
        },
        "encoding": {
          "y": {
            "field": "lLabel",
            "type": "nominal",
            "sort": {"field": "l", "op": "max", "order": "descending"},
            "axis": {
              "title": "{{#if likelihoodTitle}}{{{jsonEscape likelihoodTitle}}}{{else}}Likelihood{{/if}}",
              "domain": false,
              "ticks": false,
              "grid": false,
              "labelFontSize": 12,
              "labelColor": "currentColor",
              "labelLimit": 0,
              "titleFontSize": 13,
              "titleFontWeight": "normal",
              "titleColor": "currentColor"
            }
          },
          "x": {
            "field": "iLabel",
            "type": "nominal",
            "sort": {"field": "i", "op": "max", "order": "ascending"},
            "axis": {
              "title": "{{#if impactTitle}}{{{jsonEscape impactTitle}}}{{else}}Impact{{/if}}",
              "orient": "bottom",
              "labelAngle": 0,
              "labelExpr": "split(replace(replace(datum.label, /(.{1,11})(\\s+|$)/g, '$1\\n'), /\\n$/, ''), '\\n')",
              "domain": false,
              "ticks": false,
              "grid": false,
              "labelFontSize": 12,
              "labelColor": "currentColor",
              "labelLimit": 0,
              "titleFontSize": 13,
              "titleFontWeight": "normal",
              "titleColor": "currentColor"
            }
          },
          "text": {"field": "count", "type": "quantitative"},
          "fill": {"field": "ink", "type": "nominal", "scale": null, "legend": null}
        }
      }{{#if legend}},
      {
        "data": {"values": [{"legend": "{{{jsonEscape legend}}}"}]},
        "transform": [
          {
            "calculate": "split(replace(replace(datum.legend, /(.{1,40})(\\s+|$)/g, '$1\\n'), /\\n$/, ''), '\\n')",
            "as": "lines"
          }
        ],
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "top",
          "x": {"expr": "width / 2"},
          "y": {"expr": "height + 52"},
          "fontSize": 14,
          "color": "currentColor",
          "opacity": 0.7
        },
        "encoding": {
          "text": {"field": "lines"}
        }
      }{{/if}}
    ]
  }
{{/vegaLite}}
