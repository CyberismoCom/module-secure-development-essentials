select("title"; "base/fieldTypes/category"; "base/fieldTypes/briefDescription").

result(Card) :-
{{#if category}}
    field(Card, "base/fieldTypes/category", "{{category}}"),
{{/if}}
{{#if descendants}}
    ancestor(Card, {{cardKey}}),
{{/if}}
    field(Card, "cardType", "base/cardTypes/predicate"),
    not template(Parent) :
    parent(Card, Parent).

{{#if orderBy}}
order(1, "results", 1, "{{orderBy}}", "ASC").
order(1, "results", 2, "title", "ASC").
{{else}}
order(1, "results", 1, "title", "ASC").
{{/if}}