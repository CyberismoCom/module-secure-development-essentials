select("title";"base/fieldTypes/owner";"workflowState").

result(result).

childResult(result, Card, "activeAssignments") :-
    ancestor(Card, {{cardKey}}),
    field(Card, "cardType", "base/cardTypes/roleAssignment"),
    not field(Card, "workflowState", "Archived").

childResult(result, Card, "archivedAssignments") :-
    ancestor(Card, {{cardKey}}),
    field(Card, "cardType", "base/cardTypes/roleAssignment"),
    field(Card, "workflowState", "Archived").

orderBy("workflowState", "ASC", "title", "ASC").
