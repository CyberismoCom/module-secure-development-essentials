selectAll.

result(result).

childResult(result, Review, "reviews") :-
    parent(Review, Phase),
    secdeva_closestProject({{cardKey}}, Project),
    field(Phase, "base/fieldTypes/identifier", "{{phase}}"),
    secdeva_closestProject(Phase, Project),
    field(Review, "cardType", "base/cardTypes/review").

childObject(result, Phase, "phase") :-
    secdeva_closestProject({{cardKey}}, Project),
    field(Phase, "base/fieldTypes/identifier", "{{phase}}"),
    secdeva_closestProject(Phase, Project).

orderBy("rank", "ASC").