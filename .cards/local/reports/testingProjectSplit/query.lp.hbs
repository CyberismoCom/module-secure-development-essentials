secdeva_splitExpect("secdeva_control_risk-mitigation-testing", "secdeva/templates/project2").
secdeva_splitExpect("secdeva_control_penetration-testing", "secdeva/templates/project2").
secdeva_splitExpect("secdeva_control_document-attack-surface", "secdeva/templates/project2").
secdeva_splitExpect("secdeva_control_attack-surface-analysis", "secdeva/templates/project2").
secdeva_splitExpect("secdeva_control_use-of-cryptography", "secdeva/templates/secureDevelopmentDesign").
secdeva_splitExpect("secdeva_control_security-design-review", "secdeva/templates/secureDevelopmentDesign").
secdeva_splitExpect("secdeva_control_subprojects", "secdeva/templates/secureDevelopmentDesign").
