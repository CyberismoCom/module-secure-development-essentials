{{#createLinks}}
  "buttonLabel": "Add outbound dataflows",
  "linkType": "secdeva/linkTypes/dataflow",
  "direction": "outbound",
  "cardKey": "{{../cardKey}}",
  "query": {{#quoted}}
result(X) :- secdeva_modelOf({{{../cardKey}}}, Model), secdeva_modelOf(X, Model), secdeva_dataflowElement(X).
