{{#if layout}}
attr(graph, toplevelGraph, rankdir, "{{layout}}").
{{/if}}

% A zone is an innermost technical trust boundary, such as a network segment.
% Everything inside a zone is hidden, and the zone is drawn as a single node
% that represents its contents. Elements outside all zones, such as persons and
% external entities, are drawn as they are.
%
% Boundaries that group other boundaries are drawn around them: physical and
% organisational trust boundaries, such as a site, and zones that contain
% nested zones, such as a control network with one zone per production cell.

% By default, all dataflow elements in the project are in scope, as in the label
% view. The optional parameter root limits the scope to the descendants of one
% card, such as a threat model.
{{#if root}}
inScope(X) :- entity(X), ancestor(X, {{root}}).
{{else}}
inScope(X) :- entity(X), projectCard(X).
{{/if}}

% openBoundary(B): a boundary that is drawn as a cluster around what it contains.
% It is a physical or organisational boundary (enclosingBoundary, defined in the
% model) or a zone with nested zones, and it is not inside anything else than
% other open boundaries.
groupingBoundary(B) :- enclosingBoundary(B).
groupingBoundary(B) :- technicalBoundary(B), consistsOf(B, C), technicalBoundary(C).
openBoundary(B) :- groupingBoundary(B), inScope(B), not consistsOf(_, B).
openBoundary(B) :- groupingBoundary(B), consistsOf(P, B), openBoundary(P).

% outermost(X): X is at the top level of the model, or only inside open boundaries
outermost(X) :- inScope(X), not consistsOf(_, X), not openBoundary(X).
outermost(X) :- inScope(X), consistsOf(P, X), openBoundary(P), not openBoundary(X).

% The outermost elements are drawn as single nodes: a zone stands for
% everything inside it, and so does a process outside all zones.
zone(Z) :- outermost(Z), trustBoundary(Z).
drawn(X) :- outermost(X).
visible(X) :- drawn(X).
hide(X) :- drawn(A), contains(A, X).
% open boundaries become visible through the visible elements they contain

% the drawn element that stands for each entity
conduitEnd(A, A) :- drawn(A).
conduitEnd(X, A) :- drawn(A), contains(A, X).

% A conduit merges all dataflows between two drawn elements. Dataflows inside
% one zone are not shown.
conduit(A, B, N) :-
    conduitEnd(_, A), conduitEnd(_, B), A != B,
    N = #count { X, Y, T : dataflow(X, Y, T), conduitEnd(X, A), conduitEnd(Y, B) },
    N > 0.

conduitTitle(A, B, "1 dataflow") :- conduit(A, B, 1).
conduitTitle(A, B, @concatenate(N, " dataflows")) :- conduit(A, B, N), N > 1.

% The conduits are the only edges: the dataflows themselves are not drawn, not
% even between two elements outside the zones.
ownEdges.
edge_((A, B, T), toplevelGraph, A, B) :- conduitTitle(A, B, T).

% Conduit labels are short, so conduits between zones of the same row get
% external labels, which keep them from tangling with the conduits that come
% down into the row.
sideEdgeExternalLabels.

